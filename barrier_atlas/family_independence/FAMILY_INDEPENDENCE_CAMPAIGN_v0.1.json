  "independent_family_rule": {
    "required": [
      "distinct physical reaction family rather than another temperature point or isotopologue of an existing family",
      "operational mechanistic-class assignment adjudicated independently of predicted-versus-observed agreement",
      "barrier or free-energy quantity typed exactly as supplied or reproducibly calculated",
      "rate order, units, standard state, temperature, pressure, medium and composition matched or explicitly mapped",
      "prediction/model inputs not fit to the same target rate used as validation unless the target is quarantined as calibration",
      "rate-derived activation quantities cannot independently validate the rate from which they were derived",
      "method variants and replicate calculations remain replicates rather than new physical families"
    ],
    "same_family_by_default": [
      "temperature series",
      "isotopologue series",
      "solvent or catalyst variants that preserve the same declared elementary family unless a separately adjudicated mechanism change establishes otherwise",
      "electronic-structure method variants"
    ]
